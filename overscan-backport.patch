+                monbox.w -= ACTIVE_RULE.m_overscanTL.x + ACTIVE_RULE.m_overscanBR.x;
+                monbox.h -= ACTIVE_RULE.m_overscanTL.y + ACTIVE_RULE.m_overscanBR.y;
+
+                // black out the border region only
+                const auto SAVED_DAMAGE = m_renderData.damage;
+                m_renderData.damage     = CRegion{OLD_MONBOX}.subtract(CRegion{monbox});
