+                m_renderData.damage = SAVED_DAMAGE;
+
+                // partial damage cannot be mapped 1:1 onto a squished image,
+                // so present the whole panel every frame to avoid artifacts
+                m_renderData.damage      = CRegion{OLD_MONBOX};
+                m_renderData.finalDamage = CRegion{OLD_MONBOX};
+            }
+
+            if (NEEDS_CM && HAS_FINAL_SHADER) {
