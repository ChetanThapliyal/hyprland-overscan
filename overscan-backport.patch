-        const bool PRIMITIVE_BLOCKED = NEEDS_CM || HAS_FINAL_SHADER;
+        const auto ACTIVE_RULE       = g_pHyprRenderer->m_renderData.pMonitor->m_activeMonitorRule;
+        const bool HAS_OVERSCAN      = ACTIVE_RULE.hasOverscan();
+        const bool PRIMITIVE_BLOCKED = NEEDS_CM || HAS_FINAL_SHADER || HAS_OVERSCAN;
 
         if LIKELY (!PRIMITIVE_BLOCKED || g_pHyprRenderer->m_renderMode != RENDER_MODE_NORMAL)
             renderTexturePrimitive(TEX, monbox);
